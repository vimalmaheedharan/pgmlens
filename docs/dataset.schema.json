{
  "$defs": {
    "Dependency": {
      "additionalProperties": false,
      "description": "``blocker_id`` must finish before ``blocked_id`` can.",
      "properties": {
        "blocker_id": {
          "title": "Blocker Id",
          "type": "string"
        },
        "blocked_id": {
          "title": "Blocked Id",
          "type": "string"
        }
      },
      "required": [
        "blocker_id",
        "blocked_id"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EventType"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "issue_id",
        "type",
        "at"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "status_changed",
        "assigned",
        "scope_added",
        "estimate_changed",
        "milestone_changed",
        "comment"
      ],
      "title": "EventType",
      "type": "string"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "key": {
          "description": "Human-facing key, e.g. PLAT-123.",
          "title": "Key",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "assignee": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assignee"
        },
        "estimate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Story points or similar; optional.",
          "title": "Estimate"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "resolved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved At"
        },
        "milestone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Milestone Id"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "due_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due Date"
        }
      },
      "required": [
        "id",
        "project_id",
        "key",
        "title",
        "status",
        "created_at",
        "updated_at"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Milestone": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "due_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due Date"
        },
        "start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when the milestone belongs to one project; null if program-wide.",
          "title": "Project Id"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Milestone",
      "type": "object"
    },
    "ProgramInfo": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ProgramInfo",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        }
      },
      "required": [
        "id",
        "key",
        "name"
      ],
      "title": "Project",
      "type": "object"
    },
    "Status": {
      "enum": [
        "todo",
        "in_progress",
        "blocked",
        "done"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "program": {
      "$ref": "#/$defs/ProgramInfo"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "projects": {
      "items": {
        "$ref": "#/$defs/Project"
      },
      "title": "Projects",
      "type": "array"
    },
    "milestones": {
      "items": {
        "$ref": "#/$defs/Milestone"
      },
      "title": "Milestones",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/Dependency"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "program",
    "as_of"
  ],
  "title": "Dataset",
  "type": "object"
}
